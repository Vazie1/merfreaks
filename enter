-- ==========================================
-- ASTROWARE STANDALONE STATUS CHECKER
-- ==========================================
local function checkAstroWareStatus()
    local cacheBuster = tostring(os.time())
    local cdnUrl = "https://cdn.jsdelivr.net/gh/Vazie1/merfreaks@main/enter?v=" .. cacheBuster
    local rawUrl = "https://raw.githubusercontent.com/Vazie1/merfreaks/main/enter?v=" .. cacheBuster

    print("[AstroWare Checker] Fetching status from CDN...")
    local success, response = pcall(function()
        local res = game:HttpGet(cdnUrl)
        if not res or res == "" or res:find("404") then
            print("[AstroWare Checker] CDN failed or returned 404. Falling back to Raw GitHub...")
            res = game:HttpGet(rawUrl)
        end
        return res
    end)

    if not success or not response then
        warn("[AstroWare Checker] Error: HttpGet request completely failed.")
        return false
    end

    -- Clean the response and check for 'true'
    local cleaned = response:gsub("[^a-zA-Z0-9]", ""):lower()
    print("[AstroWare Checker] Raw Response:", response)
    print("[AstroWare Checker] Cleaned Response:", cleaned)

    if cleaned:find("true") then
        print("[AstroWare Checker] STATUS: ONLINE (true)")
        return true
    else
        print("[AstroWare Checker] STATUS: OFFLINE / DISABLED (false)")
        return false
    end
end

-- Run it right now
checkAstroWareStatus()
